# MedRead Environment Variables Configuration
# Copy this file to .env.local for production or Supabase connection

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Optional for local development, required for production deploy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
